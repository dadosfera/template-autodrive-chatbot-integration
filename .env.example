# ==============================================================================
# AutoDrive Chatbot integration — environment configuration
# Copy to .env and fill in. Values marked "from Dadosfera" are issued per
# environment (dev / stg / prod) by the Dadosfera team.
# ==============================================================================

# --- REQUIRED: credentials (server-side only, never in page HTML/JS) ----------
# From Dadosfera.
# GOTCHA: if the secret you received is base64-encoded (ends in "=="), the
# /auth/token endpoint expects the DECODED value: `echo '<shared>' | base64 -d`.
# Sending the encoded form yields 401 invalid_client.
AUTODRIVE_AUTH_CLIENT_ID=
AUTODRIVE_AUTH_CLIENT_SECRET=

# --- REQUIRED: Assistant API base URL ----------------------------------------
# Public base URL of the Dadosfera Assistant API — NOT your own site's host.
# The widget builds {AUTODRIVE_URL}/datasets/{datasetId}/ai-question from it.
AUTODRIVE_URL=https://autodrive-assistant-api-verticity.stg.dadosfera.ai

# --- REQUIRED: what the chat talks to ----------------------------------------
# Public client/tenant identifier.
AUTODRIVE_CLIENT=verticity
# AutoDrive dataset / knowledge base the chat uses.
AUTODRIVE_DATASET_ID=21225fd5-b523-466c-8f5d-548b8b059d3f
# Required when AUTODRIVE_API_PROFILE=assistant. Verticity has two assistants:
#   Business  = 67d07db4-5eb0-430e-ac64-ff1ac63836f4
#   Technical = db739c3d-74bf-40f3-839b-984a0df25739
AUTODRIVE_ASSISTANT_ID=67d07db4-5eb0-430e-ac64-ff1ac63836f4
# "assistant" (assistant mode) or "embed" (classic dataset/KB mode).
AUTODRIVE_API_PROFILE=embed
# Logical environment: dev | stg | prod | custom.
AUTODRIVE_ENVIRONMENT=stg

# --- OPTIONAL: widget bundle host --------------------------------------------
# Serves {host}/chatbot/autodrive-chatbot.umd.cjs.
AUTODRIVE_WIDGET_HOST=https://autodrive-verticity.stg.dadosfera.ai

# --- OPTIONAL: behavior -------------------------------------------------------
# Path on THIS backend that the widget calls for a temporary token.
AUTODRIVE_TOKEN_ENDPOINT=/api/autodrive/chat-token
# UI and answer language: pt-BR (default) | en-US | es-ES.
AUTODRIVE_LOCALE=en-US

# --- OPTIONAL: appearance -----------------------------------------------------
AUTODRIVE_TITLE=AutoDrive Assistant
AUTODRIVE_PLACEHOLDER=Type your question...
# bottom-right | bottom-left | inline
AUTODRIVE_POSITION=bottom-right
AUTODRIVE_PRIMARY_COLOR=#111827
AUTODRIVE_ACCENT_COLOR=#2563EB
AUTODRIVE_LAUNCHER_LABEL=Open assistant

# --- OPTIONAL: mock host only -------------------------------------------------
# true => widget calls go through {this host}/autodrive-api/* and the backend
# forwards them to AUTODRIVE_URL. Needed when this page's origin (e.g.
# http://localhost:8080) is NOT in the Assistant API's CORS allow-list.
# Customer sites with an allow-listed origin don't need it.
AUTODRIVE_DEV_PROXY=true
# Origin the proxy presents upstream (an allow-listed customer origin).
AUTODRIVE_DEV_PROXY_ORIGIN=https://build.verticity.com:8004
# true => the token endpoint returns a synthetic token without calling the
# Assistant API, so the page can be demoed with no credentials.
AUTODRIVE_MOCK_TOKEN=false
# Stands in for the logged-in user's id; sent as externalUserId.
MOCK_EXTERNAL_USER_ID=demo-user-1
# Host port published by docker compose.
PORT=8080
